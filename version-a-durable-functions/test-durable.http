@localUrl = http://localhost:7071/api/validate-expense
@cloudUrl = https://cst8917-function-app-expense-validation.azurewebsites.net/api/validate-expense


############################################################
# SCENARIO 1
# Valid expense under $100
# Expected:
# - Validation: valid = true
# - Logic App: Auto-approved
# - No manager approval required
# - Employee receives automatic approval email
############################################################

### Scenario 1 - Under $100 - Auto-approved

POST http://localhost:7071/api/expenses
Content-Type: application/json

{
  "employeeName": "Test Employee Scenario 1",
  "employeeEmail": "hy2working@gmail.com",
  "amount": 50.00,
  "category": "meals",
  "description": "Team lunch",
  "managerEmail": "hy2working@gmail.com"
}


############################################################
# SCENARIO 2
# Valid expense >= $100 - Manager approves
# Expected:
# - Validation: valid = true
# - Logic App sends approval email to manager
# - Manager selects Approve
# - Outcome: Approved
# - Employee receives approval email
############################################################

### Scenario 2 - $250 - Manager Approves

POST http://localhost:7071/api/expenses
Content-Type: application/json

{
  "employeeName": "Test Employee Scenario 2",
  "employeeEmail": "hy2working@gmail.com",
  "amount": 250.00,
  "category": "equipment",
  "description": "New computer monitor",
  "managerEmail": "hy2working@gmail.com"
}


############################################################
# SCENARIO 3
# Valid expense >= $100 - Manager rejects
# Expected:
# - Validation: valid = true
# - Logic App sends approval email to manager
# - Manager selects Reject
# - Outcome: Rejected
# - Employee receives rejection email
############################################################

### Scenario 3 - $450 - Manager Rejects

POST http://localhost:7071/api/expenses
Content-Type: application/json

{
  "employeeName": "Test Employee Scenario 3",
  "employeeEmail": "hy2working@gmail.com",
  "amount": 450.00,
  "category": "software",
  "description": "Cloud software subscription",
  "managerEmail": "hy2working@gmail.com"
}


############################################################
# SCENARIO 4
# Valid expense >= $100 - No manager response
# Expected:
# - Validation: valid = true
# - Logic App waits for manager decision
# - Manager does NOT respond
# - Timeout occurs
# - Expense auto-approved
# - escalated = true
# - Employee receives escalation/approval email
############################################################

